  "ncs_v2_progress_item.xml": {
    "sha256": "05d5ecf18c37559f99bbc771f54eea58a59cb1c9f4e2f9d6dd424e3600f03a4d",
    "ids": [
      "@+id/ncs_v2_progress_root",
      "@+id/ncs_v2_progress_count",
      "@+id/ncs_v2_progress_status",
      "@+id/ncs_v2_progress_track",
      "@+id/ncs_v2_progress_bar",
      "@+id/ncs_v2_progress_minimum_fill"
    ],
    "variables": [
      {
        "name": "correctAnswers",
        "type": "int"
      },
      {
        "name": "requiredAnswers",
        "type": "int"
      }
    ],
    "bindings": [
      {
        "id": "@+id/ncs_v2_progress_count",
        "k": "android:text",
        "v": "@{correctAnswers == 1 ? @string/ncs_v2_correct_answers_singular(correctAnswers) : @string/ncs_v2_correct_answers_plural(correctAnswers)}"
      },
      {
        "id": "@+id/ncs_v2_progress_status",
        "k": "android:text",
        "v": "@{requiredAnswers > 0 && correctAnswers >= requiredAnswers ? @string/ncs_v2_minimum_reached : @string/ncs_v2_required_minimum(requiredAnswers)}"
      },
      {
        "id": "@+id/ncs_v2_progress_status",
        "k": "android:textColor",
        "v": "@{requiredAnswers > 0 && correctAnswers >= requiredAnswers ? @color/ncs_v2_success : @color/ncs_v2_muted}"
      },
      {
        "id": "@+id/ncs_v2_progress_bar",
        "k": "android:max",
        "v": "@{requiredAnswers}"
      },
      {
        "id": "@+id/ncs_v2_progress_bar",
        "k": "android:progress",
        "v": "@{correctAnswers}"
      },
      {
        "id": "@+id/ncs_v2_progress_minimum_fill",
        "k": "android:visibility",
        "v": "@{correctAnswers > 0 && correctAnswers < requiredAnswers ? View.VISIBLE : View.GONE}"
      }
    ]
  },
