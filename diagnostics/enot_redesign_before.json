  "ncs_v2_equation_item.xml": {
    "sha256": "223a7f1e06a227fa42a677583151cf5edf0d61eb954a64f010c00e24eba35c81",
    "ids": [
      "@+id/ncs_v2_equation_root",
      "@+id/ncs_v2_equation_sum",
      "@+id/ncs_v2_equation_equals",
      "@+id/ncs_v2_equation_known",
      "@+id/ncs_v2_equation_plus",
      "@+id/ncs_v2_equation_missing"
    ],
    "variables": [
      {
        "name": "question",
        "type": "me.proton.jobforandroid.compositionofnumbers.domain.entity.Question"
      },
      {
        "name": "sum",
        "type": "int"
      },
      {
        "name": "known",
        "type": "int"
      },
      {
        "name": "missingText",
        "type": "String"
      },
      {
        "name": "solved",
        "type": "boolean"
      }
    ],
    "bindings": [
      {
        "k": "android:visibility",
        "v": "@{question.operation == Operation.ADDITION ? View.VISIBLE : View.GONE}"
      },
      {
        "id": "@+id/ncs_v2_equation_sum",
        "k": "app:numberAsText",
        "v": "@{sum}"
      },
      {
        "id": "@+id/ncs_v2_equation_known",
        "k": "app:numberAsText",
        "v": "@{known}"
      },
      {
        "id": "@+id/ncs_v2_equation_missing",
        "k": "android:text",
        "v": "@{solved ? missingText : @string/ncs_v2_math_question_mark}"
      },
      {
        "k": "android:visibility",
        "v": "@{question.operation == Operation.SUBTRACTION || question.operation == Operation.MULTIPLICATION || question.operation == Operation.DIVISION ? View.VISIBLE : View.GONE}"
      },
      {
        "k": "app:numberAsText",
        "v": "@{question.firstOperand}"
      },
      {
        "k": "android:text",
        "v": "@{question.operation == Operation.MULTIPLICATION ? @string/ncs_v2_math_multiply : question.operation == Operation.DIVISION ? @string/ncs_v2_math_divide : @string/ncs_v2_math_minus}"
      },
      {
        "k": "android:background",
        "v": "@{question.unknownPosition == UnknownPosition.SECOND_OPERAND ? @drawable/ncs_v2_equation_slot : null}"
      },
      {
        "k": "android:text",
        "v": "@{!solved && question.unknownPosition == UnknownPosition.SECOND_OPERAND ? @string/ncs_v2_math_question_mark : question.secondOperand + ``}"
      },
      {
        "k": "android:background",
        "v": "@{question.unknownPosition == UnknownPosition.RESULT ? @drawable/ncs_v2_equation_slot : null}"
      },
      {
        "k": "android:text",
        "v": "@{!solved && question.unknownPosition == UnknownPosition.RESULT ? @string/ncs_v2_math_question_mark : question.result + ``}"
      }
    ]
  },
  "ncs_v2_feedback_item.xml": {
    "sha256": "dce9d43a63a2cd9700253495ea754991bd72e5fe44753ff7abdc83c45e5c1601",
    "ids": [
      "@+id/ncs_v2_feedback_root",
      "@+id/ncs_v2_feedback_indicator",
      "@+id/ncs_v2_feedback_symbol",
      "@+id/ncs_v2_feedback_message"
    ],
    "variables": [
      {
        "name": "question",
        "type": "me.proton.jobforandroid.compositionofnumbers.domain.entity.Question"
      },
      {
        "name": "correct",
        "type": "boolean"
      },
      {
        "name": "incorrect",
        "type": "boolean"
      }
    ],
    "bindings": [
      {
        "id": "@+id/ncs_v2_feedback_indicator",
        "k": "android:background",
        "v": "@{correct ? @drawable/ncs_v2_indicator_success : incorrect ? @drawable/ncs_v2_indicator_attention : @drawable/ncs_v2_indicator_neutral}"
      },
      {
        "id": "@+id/ncs_v2_feedback_symbol",
        "k": "android:text",
        "v": "@{correct ? @string/ncs_v2_checkmark : incorrect ? @string/ncs_v2_math_multiply : @string/ncs_v2_level_marker_easy}"
      },
      {
        "id": "@+id/ncs_v2_feedback_symbol",
        "k": "android:textColor",
        "v": "@{correct ? @color/ncs_v2_success : incorrect ? @color/ncs_v2_warm_ink : @color/ncs_v2_muted}"
      },
      {
        "id": "@+id/ncs_v2_feedback_message",
        "k": "android:text",
        "v": "@{correct ? (question.operation == Operation.ADDITION ? @string/ncs_v2_answer_correct(question.firstOperand, question.secondOperand, question.result) : question.operation == Operation.SUBTRACTION ? @string/ncs_v2_subtraction_answer_correct(question.firstOperand, question.secondOperand, question.result) : question.operation == Operation.MULTIPLICATION ? @string/ncs_v2_multiplication_answer_correct(question.firstOperand, question.secondOperand, question.result) : @string/ncs_v2_division_answer_correct(question.firstOperand, question.secondOperand, question.result)) : incorrect ? (question.operation == Operation.ADDITION ? @string/ncs_v2_answer_wrong(question.firstOperand, question.secondOperand, question.result) : question.operation == Operation.SUBTRACTION ? @string/ncs_v2_subtraction_answer_wrong(question.firstOperand, question.secondOperand, question.result) : question.operation == Operation.MULTIPLICATION ? @string/ncs_v2_multiplication_answer_wrong(question.firstOperand, question.secondOperand, question.result) : @string/ncs_v2_division_answer_wrong(question.firstOperand, question.secondOperand, question.result)) : @string/ncs_v2_tap_correct_number}"
      },
      {
        "id": "@+id/ncs_v2_feedback_message",
        "k": "android:textColor",
        "v": "@{correct ? @color/ncs_v2_success : incorrect ? @color/ncs_v2_warm_ink : @color/ncs_v2_muted}"
      }
    ]
  },
  "ncs_v2_game.xml": {
    "sha256": "409e6525d1d4ee497274c94eef58c1ab308559334b0a00627d1106de25d05c9f",
    "ids": [
      "@+id/ncs_v2_game_back_button",
      "@+id/ncs_v2_game_equation",
      "@+id/ncs_v2_game_answer_1",
      "@+id/ncs_v2_game_answer_2",
      "@+id/ncs_v2_game_answer_3",
      "@+id/ncs_v2_game_answer_4",
      "@+id/ncs_v2_game_answer_5",
      "@+id/ncs_v2_game_answer_6",
      "@+id/ncs_v2_game_feedback",
      "@+id/ncs_v2_game_progress",
      "@+id/ncs_v2_game_timer"
    ],
    "variables": [
      {
        "name": "viewModel",
        "type": "me.proton.jobforandroid.compositionofnumbers.presentation.GameViewModel"
      },
      {
        "name": "displayedQuestion",
        "type": "me.proton.jobforandroid.compositionofnumbers.domain.entity.Question"
      },
      {
        "name": "selectedOptionIndex",
        "type": "int"
      },
      {
        "name": "feedbackVisible",
        "type": "boolean"
      },
      {
        "name": "feedbackCorrect",
        "type": "boolean"
      },
      {
        "name": "levelContext",
        "type": "String"
      }
    ],
    "bindings": [
      {
        "k": "android:text",
        "v": "@{levelContext}"
      },
      {
        "id": "@+id/ncs_v2_game_equation",
        "k": "app:known",
        "v": "@{displayedQuestion.visibleNumber}"
      },
      {
        "id": "@+id/ncs_v2_game_equation",
        "k": "app:missingText",
        "v": "@{displayedQuestion.rightAnswer + ``}"
      },
      {
        "id": "@+id/ncs_v2_game_equation",
        "k": "app:question",
        "v": "@{displayedQuestion}"
      },
      {
        "id": "@+id/ncs_v2_game_equation",
        "k": "app:solved",
        "v": "@{feedbackVisible}"
      },
      {
        "id": "@+id/ncs_v2_game_equation",
        "k": "app:sum",
        "v": "@{displayedQuestion.sum}"
      },
      {
        "id": "@+id/ncs_v2_game_answer_1",
        "k": "app:answerValue",
        "v": "@{displayedQuestion.options[0]}"
      },
      {
        "id": "@+id/ncs_v2_game_answer_1",
        "k": "app:correct",
        "v": "@{feedbackVisible && feedbackCorrect && selectedOptionIndex == 0}"
      },
      {
        "id": "@+id/ncs_v2_game_answer_1",
        "k": "app:enabled",
        "v": "@{!feedbackVisible}"
      },
      {
        "id": "@+id/ncs_v2_game_answer_1",
        "k": "app:incorrect",
        "v": "@{feedbackVisible && !feedbackCorrect && selectedOptionIndex == 0}"
      },
      {
        "id": "@+id/ncs_v2_game_answer_1",
        "k": "app:pressed",
        "v": "@{feedbackVisible && selectedOptionIndex == 0}"
      },
      {
        "id": "@+id/ncs_v2_game_answer_2",
        "k": "app:answerValue",
        "v": "@{displayedQuestion.options[1]}"
      },
      {
        "id": "@+id/ncs_v2_game_answer_2",
        "k": "app:correct",
        "v": "@{feedbackVisible && feedbackCorrect && selectedOptionIndex == 1}"
