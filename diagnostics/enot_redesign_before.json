        "k": "android:text",
        "v": "@{label}"
      },
      {
        "id": "@+id/ncs_v2_metric_value",
        "k": "android:text",
        "v": "@{valueText}"
      },
      {
        "id": "@+id/ncs_v2_metric_target",
        "k": "android:text",
        "v": "@{targetStatusText}"
      },
      {
        "id": "@+id/ncs_v2_metric_target",
        "k": "android:textColor",
        "v": "@{achieved ? @color/ncs_v2_success : @color/ncs_v2_warm_ink}"
      },
      {
        "k": "android:visibility",
        "v": "@{standalone ? View.VISIBLE : View.GONE}"
      }
    ]
  },
