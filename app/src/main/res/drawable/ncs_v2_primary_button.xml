<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/ncs_v2_primary_disabled" />
    <item android:state_pressed="true" android:drawable="@drawable/ncs_v2_primary_pressed" />
    <item android:state_focused="true" android:drawable="@drawable/ncs_v2_primary_focused" />
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ncs_v2_primary_pressed" />
                    <corners android:radius="@dimen/ncs_v2_radius_control" />
                </shape>
            </item>
            <item android:bottom="@dimen/ncs_v2_button_lower_edge">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ncs_v2_primary" />
                    <corners
                        android:topLeftRadius="@dimen/ncs_v2_radius_control"
                        android:topRightRadius="@dimen/ncs_v2_radius_control"
                        android:bottomLeftRadius="@dimen/ncs_v2_button_face_bottom_radius"
                        android:bottomRightRadius="@dimen/ncs_v2_button_face_bottom_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
