<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ncs_v2_primary" />
            <stroke android:width="@dimen/ncs_v2_stroke_regular" android:color="@color/ncs_v2_primary" />
            <corners android:radius="@dimen/ncs_v2_radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ncs_v2_surface" />
            <stroke android:width="@dimen/ncs_v2_stroke_regular" android:color="@color/ncs_v2_border" />
            <corners android:radius="@dimen/ncs_v2_radius_pill" />
        </shape>
    </item>
</selector>
