<?xml
    version="1.0"
    encoding="utf-8"
?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android"
>
    <item
        android:state_enabled="false"
    >
        <shape
            android:shape="rectangle"
        >
            <solid
                android:color="@color/ncs_v2_disabled"
            />
            <stroke
                android:width="@dimen/ncs_v2_stroke_regular"
                android:color="@color/ncs_v2_yellow"
            />
            <corners
                android:radius="@dimen/ncs_v2_radius_control"
            />
        </shape>
    </item>
    <item
        android:state_pressed="true"
    >
        <shape
            android:shape="rectangle"
        >
            <solid
                android:color="@color/ncs_v2_selected"
            />
            <stroke
                android:width="@dimen/ncs_v2_stroke_regular"
                android:color="@color/ncs_v2_yellow"
            />
            <corners
                android:radius="@dimen/ncs_v2_radius_control"
            />
        </shape>
    </item>
    <item
        android:state_focused="true"
    >
        <shape
            android:shape="rectangle"
        >
            <solid
                android:color="@color/ncs_v2_surface"
            />
            <stroke
                android:width="@dimen/ncs_v2_stroke_emphasis"
                android:color="@color/ncs_v2_yellow"
            />
            <corners
                android:radius="@dimen/ncs_v2_radius_control"
            />
        </shape>
    </item>
    <item>
        <shape
            android:shape="rectangle"
        >
            <solid
                android:color="@color/ncs_v2_paper"
            />
            <stroke
                android:width="@dimen/ncs_v2_stroke_regular"
                android:color="@color/ncs_v2_yellow"
            />
            <corners
                android:radius="@dimen/ncs_v2_radius_control"
            />
        </shape>
    </item>
</selector>
