<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ncs_v2_border" />
            <stroke android:width="@dimen/ncs_v2_stroke_thin" android:color="@color/ncs_v2_border" />
            <corners android:radius="@dimen/ncs_v2_radius_control" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ncs_v2_selected" />
            <stroke android:width="@dimen/ncs_v2_stroke_thin" android:color="@color/ncs_v2_border" />
            <corners android:radius="@dimen/ncs_v2_radius_control" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ncs_v2_surface" />
            <stroke android:width="@dimen/ncs_v2_stroke_emphasis" android:color="@color/ncs_v2_ink" />
            <corners android:radius="@dimen/ncs_v2_radius_control" />
        </shape>
    </item>
    <item android:drawable="@drawable/ncs_v2_surface_outline" />
</selector>
