<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ncs_v2_panel"
    android:orientation="vertical"
    android:padding="@dimen/ncs_v2_space_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ncs_v2_privacy_tab"
            style="@style/NcsV2.View.TouchTarget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/ncs_v2_nunito_bold"
            android:gravity="center"
            android:padding="@dimen/ncs_v2_space_8"
            android:text="@string/ncs_v2_privacy_policy_title"
            android:textColor="@color/ncs_v2_primary"
            android:textSize="@dimen/ncs_v2_text_14" />

        <TextView
            android:id="@+id/ncs_v2_terms_tab"
            style="@style/NcsV2.View.TouchTarget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/ncs_v2_nunito_bold"
            android:gravity="center"
            android:padding="@dimen/ncs_v2_space_8"
            android:text="@string/ncs_v2_terms_title"
            android:textColor="@color/ncs_v2_muted"
            android:textSize="@dimen/ncs_v2_text_14" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/ncs_v2_document_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/ncs_v2_space_12"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls">

        <TextView
            android:id="@+id/ncs_v2_document_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ncs_v2_nunito_semibold"
            android:lineSpacingMultiplier="1.3"
            android:paddingBottom="@dimen/ncs_v2_space_16"
            android:textColor="@color/ncs_v2_ink"
            android:textSize="14sp" />
    </ScrollView>

    <TextView
        android:id="@+id/ncs_v2_document_close_button"
        style="@style/NcsV2.View.Action"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ncs_v2_button_height"
        android:layout_marginTop="@dimen/ncs_v2_space_12"
        android:background="@drawable/ncs_v2_primary_button"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/ncs_v2_nunito_extrabold"
        android:gravity="center"
        android:text="@string/ncs_v2_document_close"
        android:textColor="@color/ncs_v2_surface"
        android:textSize="@dimen/ncs_v2_text_20" />
</LinearLayout>
