<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ncs_v2_notebook_background"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ncs_v2_space_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/ncs_v2_back_height"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ncs_v2_back_button"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.NcsV2.BackArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_arrow_back"
                        android:textColor="@color/ncs_v2_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ncs_v2_space_8"
                        android:fontFamily="@font/ncs_v2_nunito_extrabold"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_back"
                        android:textColor="@color/ncs_v2_primary"
                        android:textSize="@dimen/ncs_v2_text_17" />
                </LinearLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/ncs_v2_nunito_extrabold"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_brand"
                    android:textColor="@color/ncs_v2_muted"
                    android:textSize="@dimen/ncs_v2_text_14" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.NcsV2.ScreenTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:lineHeight="35dp"
                        android:text="@string/ncs_v2_choose_level_title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ncs_v2_space_8"
                        android:fontFamily="@font/ncs_v2_nunito_semibold"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_where_start"
                        android:textColor="@color/ncs_v2_muted"
                        android:textSize="@dimen/ncs_v2_text_16" />
                </LinearLayout>

                <ImageView
                    android:layout_width="123dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/cuub_1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/ncs_v2_test_level_item"
                    layout="@layout/ncs_v2_level_item"
                    android:layout_width="@dimen/ncs_v2_content_width"
                    android:layout_height="@dimen/ncs_v2_level_height"
                    app:description="@{@string/ncs_v2_unavailable}"
                    app:enabled="@{true}"
                    app:marker="@{@string/ncs_v2_level_marker_test}"
                    app:selected="@{false}"
                    app:showDescription="@{false}"
                    app:title="@{@string/ncs_v2_test_level}" />

                <include
                    android:id="@+id/ncs_v2_easy_level_item"
                    layout="@layout/ncs_v2_level_item"
                    android:layout_width="@dimen/ncs_v2_content_width"
                    android:layout_height="@dimen/ncs_v2_level_height"
                    android:layout_marginTop="@dimen/ncs_v2_space_12"
                    app:description="@{@string/ncs_v2_level_range(0, 10)}"
                    app:enabled="@{true}"
                    app:marker="@{@string/ncs_v2_level_marker_easy}"
                    app:selected="@{false}"
                    app:showDescription="@{true}"
                    app:title="@{@string/ncs_v2_easy_level}" />

                <include
                    android:id="@+id/ncs_v2_medium_level_item"
                    layout="@layout/ncs_v2_level_item"
                    android:layout_width="@dimen/ncs_v2_content_width"
                    android:layout_height="@dimen/ncs_v2_level_height"
                    android:layout_marginTop="@dimen/ncs_v2_space_12"
                    app:description="@{@string/ncs_v2_level_range(0, 20)}"
                    app:enabled="@{true}"
                    app:marker="@{@string/ncs_v2_level_marker_medium}"
                    app:selected="@{false}"
                    app:showDescription="@{true}"
                    app:title="@{@string/ncs_v2_medium_level}" />

                <include
                    android:id="@+id/ncs_v2_hard_level_item"
                    layout="@layout/ncs_v2_level_item"
                    android:layout_width="@dimen/ncs_v2_content_width"
                    android:layout_height="@dimen/ncs_v2_level_height"
                    android:layout_marginTop="@dimen/ncs_v2_space_12"
                    app:description="@{@string/ncs_v2_level_range(0, 30)}"
                    app:enabled="@{true}"
                    app:marker="@{@string/ncs_v2_level_marker_hard}"
                    app:selected="@{true}"
                    app:showDescription="@{true}"
                    app:title="@{@string/ncs_v2_hard_level}" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="132dp"
                    android:layout_height="118dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/girl_2" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ncs_v2_space_18"
                    android:layout_weight="1"
                    android:fontFamily="@font/ncs_v2_nunito_extrabold"
                    android:includeFontPadding="false"
                    android:lineHeight="22dp"
                    android:text="@string/ncs_v2_level_can_reselect"
                    android:textColor="@color/ncs_v2_ink"
                    android:textSize="@dimen/ncs_v2_text_17" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="bottom"
                android:minHeight="100dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ncs_v2_start_game_button"
                    style="@style/NcsV2.View.Action"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ncs_v2_button_height"
                    android:background="@drawable/ncs_v2_primary_button"
                    android:clickable="true"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.NcsV2.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_start_game"
                        android:textColor="@color/ncs_v2_surface" />

                    <TextView
                        style="@style/TextAppearance.NcsV2.ForwardArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_arrow_forward"
                        android:textColor="@color/ncs_v2_surface" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>
