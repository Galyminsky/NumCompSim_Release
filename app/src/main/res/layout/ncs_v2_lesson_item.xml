<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />

        <variable name="available" type="boolean" />
        <variable name="title" type="String" />
        <variable name="symbol" type="String" />
    </data>

    <FrameLayout
        android:layout_width="@dimen/ncs_v2_content_width"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ncs_v2_lesson_coming_soon_height"
        android:background="@drawable/ncs_v2_lesson_card"
        android:enabled="@{available}"
        android:paddingStart="@dimen/ncs_v2_space_18"
        android:paddingEnd="@dimen/ncs_v2_space_18">

        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/ncs_v2_lesson_available_height"
            android:visibility="@{available ? View.VISIBLE : View.GONE}" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/ncs_v2_lesson_symbol_width"
                android:layout_height="@dimen/ncs_v2_lesson_symbol_height"
                android:layout_marginEnd="@dimen/ncs_v2_space_16"
                android:background="@drawable/ncs_v2_lesson_symbol_background"
                android:enabled="@{available}">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/ncs_v2_nunito_black"
                    android:gravity="center"
                    android:text="@{symbol}"
                    android:textColor="@{available ? @color/ncs_v2_surface : @color/ncs_v2_muted}"
                    android:textSize="@dimen/ncs_v2_text_42"
                    tools:text="@string/ncs_v2_math_plus" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.NcsV2.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{title}"
                    android:textColor="@{available ? @color/ncs_v2_ink : @color/ncs_v2_muted}"
                    tools:text="@string/ncs_v2_addition" />

                <TextView
                    style="@style/TextAppearance.NcsV2.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ncs_v2_badge_height"
                    android:layout_marginTop="@dimen/ncs_v2_space_4"
                    android:background="@{available ? @drawable/ncs_v2_indicator_neutral : @drawable/ncs_v2_indicator_attention}"
                    android:gravity="center"
                    android:paddingStart="@dimen/ncs_v2_space_12"
                    android:paddingEnd="@dimen/ncs_v2_space_12"
                    android:text="@{available ? @string/ncs_v2_can_play : @string/ncs_v2_coming_soon}"
                    android:textColor="@{available ? @color/ncs_v2_primary : @color/ncs_v2_warm_ink}" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ncs_v2_space_4"
                    android:fontFamily="@font/ncs_v2_nunito_bold"
                    android:text="@string/ncs_v2_find_number_part"
                    android:textColor="@color/ncs_v2_muted"
                    android:textSize="@dimen/ncs_v2_text_14"
                    android:visibility="@{available ? View.VISIBLE : View.GONE}" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</layout>
