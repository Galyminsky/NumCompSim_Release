<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import type="android.view.View"/>
        <variable name="statistics" type="String"/>
        <variable name="minimum" type="String"/>
        <variable name="time" type="String"/>
        <variable name="support" type="String"/>
        <variable name="progress" type="int"/>
        <variable name="feedbackVisible" type="boolean"/>
    </data>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" tools:theme="@style/FractionsGamePreview">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/ncs_v2_timer_height" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/TextAppearance.NcsV2.Fractions.ExtraBold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/fractions_statistics" android:textSize="20sp" tools:text="?attr/fractions_preview_statistics" android:text="@{statistics}"/>
                <TextView style="@style/TextAppearance.NcsV2.Fractions.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="15sp" android:textColor="@color/ncs_v2_primary" tools:text="?attr/fractions_preview_minimum" android:text="@{minimum}"/>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ncs_v2_space_16" android:gravity="end" android:orientation="vertical">
                <TextView style="@style/TextAppearance.NcsV2.Fractions.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ncs_v2_primary" android:text="@string/ncs_v2_time_left"/>
                <TextView style="@style/TextAppearance.NcsV2.Fractions.ExtraBold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/fractions_time" android:textSize="30sp" tools:text="?attr/fractions_preview_time" android:text="@{time}"/>
            </LinearLayout>
        </LinearLayout>
        <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:id="@+id/fractions_progress" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="@dimen/ncs_v2_space_18" android:progressDrawable="@drawable/ncs_v2_progress_bar" android:indeterminate="false" android:max="100" android:progress="@{progress}" tools:progress="0" android:importantForAccessibility="no"/>
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="@dimen/ncs_v2_space_18">
            <ImageView android:layout_width="88.04dp" android:layout_height="0dp" app:layout_constraintHeight_max="@dimen/fractions_support_comparison_height" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/fractions_support_label" android:src="@drawable/raccoon_timer" android:scaleType="fitCenter" android:contentDescription="@null" android:importantForAccessibility="no" android:visibility="@{feedbackVisible ? View.GONE : View.VISIBLE}" tools:visibility="?attr/fractions_preview_question_visibility"/>
            <ImageView android:layout_width="88.04dp" android:layout_height="0dp" app:layout_constraintHeight_max="@dimen/fractions_support_comparison_height" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/fractions_support_label" android:src="@drawable/raccoon_thinking" android:scaleType="fitCenter" android:contentDescription="@null" android:importantForAccessibility="no" android:visibility="@{feedbackVisible ? View.VISIBLE : View.GONE}" tools:visibility="?attr/fractions_preview_resolved_visibility"/>
            <TextView android:id="@+id/fractions_support_label" style="@style/TextAppearance.NcsV2.Fractions.ExtraBold" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" android:textSize="15sp" android:gravity="center" android:textColor="@color/ncs_v2_primary" tools:text="?attr/fractions_preview_support" android:text="@{support}"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</layout>
