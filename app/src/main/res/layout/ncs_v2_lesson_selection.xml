<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="me.proton.jobforandroid.compositionofnumbers.domain.entity.Question.Operation" />
        <variable name="selectedOperation" type="Operation" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ncs_v2_notebook_background"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ncs_v2_space_24"
            android:paddingTop="@dimen/ncs_v2_space_8"
            android:paddingEnd="@dimen/ncs_v2_space_24"
            android:paddingBottom="@dimen/ncs_v2_space_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/ncs_v2_back_height"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ncs_v2_back_button"
                    android:layout_width="@dimen/ncs_v2_back_width"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp">

                    <TextView
                        style="@style/TextAppearance.NcsV2.BackArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_arrow_back"
                        android:textColor="@color/ncs_v2_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ncs_v2_space_8"
                        android:fontFamily="@font/ncs_v2_nunito_extrabold"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_back"
                        android:textColor="@color/ncs_v2_primary"
                        android:textSize="@dimen/ncs_v2_text_17" />
                </LinearLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/ncs_v2_nunito_extrabold"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_brand"
                    android:textColor="@color/ncs_v2_muted"
                    android:textSize="@dimen/ncs_v2_text_14" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/ncs_v2_space_24"
                android:paddingBottom="@dimen/ncs_v2_space_24">

                <TextView
                    style="@style/TextAppearance.NcsV2.ScreenTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:lineHeight="35dp"
                    android:text="@string/ncs_v2_choose_lesson_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ncs_v2_space_8"
                    android:fontFamily="@font/ncs_v2_nunito_semibold"
                    android:includeFontPadding="false"
                    android:lineHeight="21dp"
                    android:text="@{selectedOperation == Operation.ADDITION ? @string/ncs_v2_addition_intro : @string/ncs_v2_subtraction_selection_intro}"
                    android:textColor="@color/ncs_v2_muted"
                    android:textSize="@dimen/ncs_v2_text_16" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/ncs_v2_addition_item"
                    layout="@layout/ncs_v2_lesson_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:available="@{true}"
                    app:description="@{@string/ncs_v2_find_number_part}"
                    app:expanded="@{selectedOperation == Operation.ADDITION}"
                    app:paletteSelected="@{true}"
                    app:paletteActivated="@{false}"
                    app:symbol="@{@string/ncs_v2_math_plus}"
                    app:title="@{@string/ncs_v2_addition}" />

                <include
                    android:id="@+id/ncs_v2_subtraction_item"
                    layout="@layout/ncs_v2_lesson_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ncs_v2_space_12"
                    app:available="@{true}"
                    app:description="@{@string/ncs_v2_subtraction_selection_description}"
                    app:expanded="@{selectedOperation == Operation.SUBTRACTION}"
                    app:paletteSelected="@{false}"
                    app:paletteActivated="@{true}"
                    app:symbol="@{@string/ncs_v2_math_minus}"
                    app:title="@{@string/ncs_v2_subtraction}" />

                <include
                    android:id="@+id/ncs_v2_multiplication_item"
                    layout="@layout/ncs_v2_lesson_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ncs_v2_space_12"
                    app:available="@{false}"
                    app:description="@{@string/ncs_v2_coming_soon}"
                    app:expanded="@{false}"
                    app:paletteSelected="@{true}"
                    app:paletteActivated="@{true}"
                    app:symbol="@{@string/ncs_v2_math_multiply}"
                    app:title="@{@string/ncs_v2_multiplication}" />

                <include
                    android:id="@+id/ncs_v2_division_item"
                    layout="@layout/ncs_v2_lesson_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ncs_v2_space_12"
                    app:available="@{false}"
                    app:description="@{@string/ncs_v2_coming_soon}"
                    app:expanded="@{false}"
                    app:paletteSelected="@{false}"
                    app:paletteActivated="@{false}"
                    app:symbol="@{@string/ncs_v2_math_divide}"
                    app:title="@{@string/ncs_v2_division}" />
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ncs_v2_nunito_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineHeight="19dp"
                    android:text="@string/ncs_v2_other_lessons_soon_available"
                    android:textColor="@color/ncs_v2_muted"
                    android:textSize="@dimen/ncs_v2_text_15" />

                <LinearLayout
                    android:id="@+id/ncs_v2_start_addition_button"
                    style="@style/NcsV2.View.Action"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ncs_v2_button_height"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/ncs_v2_primary_button"
                    android:clickable="true"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.NcsV2.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@{selectedOperation == Operation.ADDITION ? @string/ncs_v2_start_addition : @string/ncs_v2_start_subtraction}"
                        android:textColor="@color/ncs_v2_surface" />

                    <TextView
                        style="@style/TextAppearance.NcsV2.ForwardArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_arrow_forward"
                        android:textColor="@color/ncs_v2_surface" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>
