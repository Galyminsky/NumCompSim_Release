<?xml
    version="1.0"
    encoding="utf-8"
?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
>
    <data>
        <variable
            name="gameResult"
            type="me.proton.jobforandroid.compositionofnumbers.domain.entity.GameResult"
        />
        <variable
            name="levelLabel"
            type="String"
        />
        <variable
            name="correctAnswerText"
            type="String"
        />
        <variable
            name="accuracyText"
            type="String"
        />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:background="@color/ncs_v2_paper"
        android:clipChildren="false"
        android:clipToPadding="false"
    >
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/ncs_v2_paper"
            android:fitsSystemWindows="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:layout_weight="1"
        >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ncs_v2_space_24"
                android:paddingTop="@dimen/ncs_v2_space_8"
                android:paddingEnd="@dimen/ncs_v2_space_24"
                android:paddingBottom="0dp"
                android:clipChildren="false"
                android:clipToPadding="false"
            >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/ncs_v2_nunito_black"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_game_result"
                        android:textColor="@color/ncs_v2_ink"
                        android:textSize="@dimen/ncs_v2_text_17"
                    />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ncs_v2_badge_height"
                        android:background="@drawable/ncs_v2_indicator_neutral"
                        android:fontFamily="@font/ncs_v2_nunito_extrabold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:paddingStart="@dimen/ncs_v2_space_12"
                        android:paddingEnd="@dimen/ncs_v2_space_12"
                        android:text="@{levelLabel}"
                        android:textColor="@color/ncs_v2_primary"
                        android:textSize="@dimen/ncs_v2_text_13"
                    />
                </LinearLayout>
                <Space
                    android:layout_width="1dp"
                    android:layout_height="wrap_content"
                />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="146dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                >
                    <ImageView
                        android:layout_width="154dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/raccoon_success"
                        android:importantForAccessibility="no"
                    />
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/decor_sparkles"
                        android:scaleType="fitCenter"
                        android:layout_gravity="end|center_vertical"
                    />
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/decor_sparkles"
                        android:scaleType="fitCenter"
                        android:layout_gravity="start|center_vertical"
                    />
                </FrameLayout>
                <Space
                    android:layout_width="1dp"
                    android:layout_height="wrap_content"
                />
                <TextView
                    style="@style/TextAppearance.NcsV2.ResultTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_result_success_title"
                    android:minHeight="40dp"
                />
                <Space
                    android:layout_width="1dp"
                    android:layout_height="wrap_content"
                />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ncs_v2_nunito_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_result_success_description"
                    android:textColor="@color/ncs_v2_primary"
                    android:textSize="@dimen/ncs_v2_text_17"
                    android:minHeight="44dp"
                    android:lineSpacingMultiplier="1.08"
                />
                <Space
                    android:layout_width="1dp"
                    android:layout_height="wrap_content"
                />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="181dp"
                    android:background="@drawable/ncs_v2_result_positive_outline"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/ncs_v2_space_18"
                    android:paddingBottom="@dimen/ncs_v2_space_18"
                    android:elevation="6dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                >
                    <include
                        android:id="@+id/ncs_v2_result_correct_metric"
                        layout="@layout/ncs_v2_metric_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:theme="@style/NcsV2MetricPreviewCorrect"
                        app:achieved="@{gameResult.winner}"
                        app:label="@{@string/ncs_v2_correct_answers_label}"
                        app:standalone="@{false}"
                        app:targetStatusText="@{@string/ncs_v2_required_reached(gameResult.gameSettings.minCountOfRightAnswers)}"
                        app:valueText="@{correctAnswerText}"
                    />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ncs_v2_stroke_thin"
                        android:layout_marginStart="@dimen/ncs_v2_space_18"
                        android:layout_marginTop="@dimen/ncs_v2_space_16"
                        android:layout_marginEnd="@dimen/ncs_v2_space_18"
                        android:background="@color/ncs_v2_border"
                    />
                    <include
                        android:id="@+id/ncs_v2_result_accuracy_metric"
                        layout="@layout/ncs_v2_metric_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ncs_v2_space_16"
                        android:theme="@style/NcsV2MetricPreviewAccuracy"
                        app:achieved="@{gameResult.winner}"
                        app:label="@{@string/ncs_v2_accuracy}"
                        app:standalone="@{false}"
                        app:targetStatusText="@{@string/ncs_v2_accuracy_required_reached(gameResult.gameSettings.minPercentOfRightAnswers)}"
                        app:valueText="@{accuracyText}"
                    />
                </LinearLayout>
                <Space
                    android:layout_width="1dp"
                    android:layout_height="wrap_content"
                />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/ncs_v2_space_16"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                >
                    <ImageView
                        android:layout_width="180dp"
                        android:layout_height="148dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/raccoon_happy"
                        android:importantForAccessibility="no"
                        android:translationY="-0.247dp"
                    />
                </FrameLayout>
                <Space
                    android:layout_width="1dp"
                    android:layout_height="wrap_content"
                />
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/ncs_v2_space_24"
            android:paddingEnd="@dimen/ncs_v2_space_24"
            android:paddingTop="@dimen/ncs_v2_space_16"
            android:paddingBottom="@dimen/ncs_v2_space_12"
        >
            <LinearLayout
                android:id="@+id/ncs_v2_result_play_again_button"
                style="@style/NcsV2.View.Action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ncs_v2_button_height"
                android:background="@drawable/ncs_v2_primary_button"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
            >
                <TextView
                    style="@style/TextAppearance.NcsV2.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_play_again"
                    android:textColor="@color/ncs_v2_surface"
                />
                <TextView
                    style="@style/TextAppearance.NcsV2.ForwardArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_arrow_forward"
                    android:textColor="@color/ncs_v2_surface"
                />
            </LinearLayout>
            <TextView
                android:id="@+id/ncs_v2_result_choose_level_button"
                style="@style/NcsV2.View.Action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ncs_v2_button_height"
                android:layout_marginTop="10dp"
                android:background="@drawable/ncs_v2_secondary_button"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:fontFamily="@font/ncs_v2_nunito_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/ncs_v2_choose_level"
                android:textColor="@color/ncs_v2_primary"
                android:textSize="@dimen/ncs_v2_text_20"
            />
        </LinearLayout>
    </LinearLayout>
</layout>
