<?xml
    version="1.0"
    encoding="utf-8"
?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
>
    <data/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ncs_v2_paper"
        android:fitsSystemWindows="true"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
    >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="@dimen/ncs_v2_space_12"
            android:paddingBottom="@dimen/ncs_v2_space_12"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
        >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/ncs_v2_back_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
            >
                <LinearLayout
                    android:id="@+id/ncs_v2_comparison_game_back_button"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="48dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                >
                    <TextView
                        style="@style/TextAppearance.NcsV2.BackArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_arrow_back"
                        android:textColor="@color/ncs_v2_primary"
                    />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ncs_v2_space_8"
                        android:fontFamily="@font/ncs_v2_nunito_extrabold"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_back"
                        android:textColor="@color/ncs_v2_primary"
                        android:textSize="@dimen/ncs_v2_text_17"
                    />
                </LinearLayout>
                <TextView
                    android:id="@+id/ncs_v2_comparison_game_context"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/ncs_v2_nunito_extrabold"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_comparison_game_context"
                    android:textColor="@color/ncs_v2_muted"
                    android:textSize="@dimen/ncs_v2_text_14"
                />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/ncs_v2_space_8"
                android:clipChildren="false"
                android:clipToPadding="false"
            >
                <TextView
                    style="@style/TextAppearance.NcsV2.Question"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_comparison_game_question"
                    android:id="@+id/ncs_v2_comparison_game_title"
                    android:layout_weight="1"
                />
                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/decor_sparkles"
                    android:scaleType="fitCenter"
                />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/ncs_v2_comparison_expression_card"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@drawable/ncs_v2_comparison_expression"
                android:contentDescription="@string/ncs_v2_comparison_game_expression_accessibility"
                android:paddingStart="@dimen/ncs_v2_space_12"
                android:paddingEnd="@dimen/ncs_v2_space_12"
                android:layout_marginTop="@dimen/ncs_v2_space_8"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_weight="1"
            >
                <LinearLayout
                    android:id="@+id/ncs_v2_comparison_expression_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                >
                    <TextView
                        android:id="@+id/ncs_v2_comparison_expression_left"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:maxLines="1"
                        android:fontFamily="@font/ncs_v2_nunito_black"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_comparison_rules_example_left"
                        android:textColor="@color/ncs_v2_expression_ink"
                        android:textSize="@dimen/ncs_v2_text_34"
                    />
                    <TextView
                        android:id="@+id/ncs_v2_comparison_expression_sign"
                        android:layout_width="@dimen/ncs_v2_touch_target_min"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ncs_v2_space_8"
                        android:layout_marginEnd="@dimen/ncs_v2_space_8"
                        android:maxLines="1"
                        android:fontFamily="@font/ncs_v2_nunito_black"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_math_question_mark"
                        android:textColor="@color/ncs_v2_yellow"
                        android:textSize="@dimen/ncs_v2_text_34"
                    />
                    <TextView
                        android:id="@+id/ncs_v2_comparison_expression_right"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:maxLines="1"
                        android:fontFamily="@font/ncs_v2_nunito_black"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_comparison_rules_example_right"
                        android:textColor="@color/ncs_v2_expression_ink"
                        android:textSize="@dimen/ncs_v2_text_34"
                    />
                </LinearLayout>
            </FrameLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ncs_v2_nunito_extrabold"
                android:includeFontPadding="false"
                android:text="@string/ncs_v2_comparison_game_choose_sign"
                android:textColor="@color/ncs_v2_ink"
                android:textSize="17sp"
                android:id="@+id/ncs_v2_comparison_game_instruction"
                android:layout_marginTop="@dimen/ncs_v2_space_8"
            />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:orientation="horizontal"
                android:id="@+id/ncs_v2_comparison_answer_row"
                android:layout_marginTop="@dimen/ncs_v2_space_8"
                android:clipChildren="false"
                android:clipToPadding="false"
            >
                <TextView
                    android:id="@+id/ncs_v2_comparison_less_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/ncs_v2_answer_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/ncs_v2_nunito_black"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_comparison_less_sign"
                    android:textColor="@color/ncs_v2_ink"
                    android:textSize="@dimen/ncs_v2_text_34"
                    android:elevation="6dp"
                />
                <Space
                    android:layout_width="@dimen/ncs_v2_space_12"
                    android:layout_height="0dp"
                />
                <TextView
                    android:id="@+id/ncs_v2_comparison_equal_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/ncs_v2_answer_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/ncs_v2_nunito_black"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_math_equals"
                    android:textColor="@color/ncs_v2_ink"
                    android:textSize="@dimen/ncs_v2_text_34"
                    android:elevation="6dp"
                />
                <Space
                    android:layout_width="@dimen/ncs_v2_space_12"
                    android:layout_height="0dp"
                />
                <TextView
                    android:id="@+id/ncs_v2_comparison_greater_button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/ncs_v2_answer_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/ncs_v2_nunito_black"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_comparison_rules_example_sign"
                    android:textColor="@color/ncs_v2_yellow"
                    android:textSize="@dimen/ncs_v2_text_34"
                    android:elevation="6dp"
                />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:gravity="center" android:baselineAligned="false"
                android:orientation="horizontal"
                android:id="@+id/ncs_v2_comparison_feedback_row"
                android:layout_marginTop="@dimen/ncs_v2_space_8"
                android:clipChildren="false"
                android:clipToPadding="false"
            >
                <TextView
                    android:id="@+id/ncs_v2_comparison_correct_indicator" android:layout_marginEnd="@dimen/ncs_v2_feedback_gap"
                    android:layout_width="@dimen/ncs_v2_space_32"
                    android:layout_height="@dimen/ncs_v2_space_32"
                    android:background="@drawable/ncs_v2_indicator_success"
                    android:fontFamily="@font/ncs_v2_inter_extrabold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_checkmark"
                    android:textColor="@color/ncs_v2_success"
                    android:textSize="@dimen/ncs_v2_text_22"
                    android:visibility="gone"
                />
                <TextView
                    android:id="@+id/ncs_v2_comparison_feedback_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center" android:minLines="2"
                    android:fontFamily="@font/ncs_v2_nunito_bold"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_comparison_game_hint"
                    android:textColor="@color/ncs_v2_muted"
                    android:textSize="@dimen/ncs_v2_text_15"
                />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ncs_v2_comparison_stats_row"
                android:layout_marginTop="@dimen/ncs_v2_space_8"
                android:clipChildren="false"
                android:clipToPadding="false"
            >
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                >
                    <TextView
                        android:id="@+id/ncs_v2_comparison_game_stats_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ncs_v2_nunito_black"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_comparison_game_stats"
                        android:textColor="@color/ncs_v2_ink"
                        android:textSize="@dimen/ncs_v2_text_20"
                    />
                    <TextView
                        android:id="@+id/ncs_v2_comparison_game_minimum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ncs_v2_space_8"
                        android:fontFamily="@font/ncs_v2_nunito_bold"
                        android:includeFontPadding="false"
                        android:textColor="@color/ncs_v2_primary"
                        android:textSize="@dimen/ncs_v2_text_15"
                    />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:fontFamily="@font/ncs_v2_nunito_bold"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_time_left"
                        android:textColor="@color/ncs_v2_primary"
                        android:textSize="@dimen/ncs_v2_text_13"
                    />
                    <TextView
                        android:id="@+id/ncs_v2_comparison_game_time_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ncs_v2_nunito_black"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_comparison_game_time_preview"
                        android:textColor="@color/ncs_v2_ink"
                        android:textSize="@dimen/ncs_v2_text_30"
                    />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/ncs_v2_comparison_progress_track"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ncs_v2_progress_track_height"
                android:background="@drawable/ncs_v2_progress_track"
                android:layout_marginTop="@dimen/ncs_v2_space_8"
                android:clipChildren="false"
                android:clipToPadding="false"
            >
                <View
                    android:id="@+id/ncs_v2_comparison_progress_fill"
                    android:layout_width="@dimen/ncs_v2_space_12"
                    android:layout_height="match_parent"
                    android:background="@drawable/ncs_v2_progress_fill"
                />
            </FrameLayout>
            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/raccoon_timer"
                android:id="@+id/ncs_v2_comparison_game_illustration"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no"
                android:layout_marginTop="@dimen/ncs_v2_space_8"
            />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ncs_v2_nunito_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/ncs_v2_comparison_game_encouragement"
                android:textColor="@color/ncs_v2_primary"
                android:textSize="@dimen/ncs_v2_text_15"
                android:id="@+id/ncs_v2_comparison_game_hint"
                android:layout_marginTop="@dimen/ncs_v2_space_8"
            />
        </LinearLayout>
    </ScrollView>
</layout>
