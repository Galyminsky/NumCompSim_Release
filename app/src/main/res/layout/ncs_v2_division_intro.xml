<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data />

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ncs_v2_notebook_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ncs_v2_space_24"
        android:paddingTop="@dimen/ncs_v2_space_8"
        android:paddingEnd="@dimen/ncs_v2_space_24"
        android:paddingBottom="@dimen/ncs_v2_space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="62dp"
                android:layout_height="58dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/owl_1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ncs_v2_space_12"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ncs_v2_nunito_black"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_brand"
                    android:textColor="@color/ncs_v2_ink"
                    android:textSize="@dimen/ncs_v2_text_25" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ncs_v2_nunito_bold"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_brand_subtitle"
                    android:textColor="@color/ncs_v2_muted"
                    android:textSize="@dimen/ncs_v2_text_13" />
            </LinearLayout>
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.NcsV2.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:lineHeight="39dp"
                android:text="@string/ncs_v2_division" />

            <TextView
                style="@style/TextAppearance.NcsV2.Intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:text="@string/ncs_v2_find_missing_number"
                android:textColor="@color/ncs_v2_muted" />
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="210dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="194dp"
                android:layout_weight="218"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/brain" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="108dp"
                android:layout_marginStart="@dimen/ncs_v2_space_8"
                android:layout_weight="128"
                android:background="@drawable/ncs_v2_welcome_speech"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/ncs_v2_space_12"
                android:rotation="-3">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ncs_v2_nunito_black"
                    android:includeFontPadding="false"
                    android:lineHeight="22dp"
                    android:text="@string/ncs_v2_together"
                    android:textColor="@color/ncs_v2_ink"
                    android:textSize="@dimen/ncs_v2_text_19" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ncs_v2_space_4"
                    android:fontFamily="@font/ncs_v2_inter_black"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_math_divide"
                    android:textColor="@color/ncs_v2_warm_ink"
                    android:textSize="@dimen/ncs_v2_text_30" />
            </LinearLayout>
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ncs_v2_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ncs_v2_nunito_extrabold"
                android:includeFontPadding="false"
                android:text="@string/ncs_v2_how_it_works"
                android:textColor="@color/ncs_v2_primary"
                android:textSize="@dimen/ncs_v2_text_14" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/ncs_v2_space_12"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="27dp"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/ncs_v2_nunito_black"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_multiplication_intro_result_number"
                    android:textColor="@color/ncs_v2_ink"
                    android:textSize="@dimen/ncs_v2_text_44" />

                <TextView
                    android:layout_width="19dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="11dp"
                    android:fontFamily="@font/ncs_v2_inter_regular"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_math_divide"
                    android:textColor="@color/ncs_v2_muted"
                    android:textSize="@dimen/ncs_v2_text_28" />

                <TextView
                    android:layout_width="27dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="11dp"
                    android:fontFamily="@font/ncs_v2_nunito_black"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_multiplication_intro_first_number"
                    android:textColor="@color/ncs_v2_ink"
                    android:textSize="@dimen/ncs_v2_text_44" />

                <TextView
                    android:layout_width="19dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="11dp"
                    android:fontFamily="@font/ncs_v2_inter_regular"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_math_equals"
                    android:textColor="@color/ncs_v2_muted"
                    android:textSize="@dimen/ncs_v2_text_28" />

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="11dp"
                    android:background="@drawable/ncs_v2_addition_number"
                    android:fontFamily="@font/ncs_v2_nunito_black"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_multiplication_intro_second_number"
                    android:textColor="@color/ncs_v2_primary"
                    android:textSize="@dimen/ncs_v2_text_44" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ncs_v2_space_12"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:fontFamily="@font/ncs_v2_nunito_semibold"
                    android:includeFontPadding="false"
                    android:lineHeight="22dp"
                    android:text="@string/ncs_v2_find_missing_number"
                    android:textColor="@color/ncs_v2_ink"
                    android:textSize="@dimen/ncs_v2_text_17" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:fontFamily="@font/ncs_v2_nunito_semibold"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_addends_instead"
                        android:textColor="@color/ncs_v2_ink"
                        android:textSize="@dimen/ncs_v2_text_17" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/ncs_v2_nunito_black"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_math_question_mark"
                        android:textColor="@color/ncs_v2_primary"
                        android:textSize="@dimen/ncs_v2_text_17" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/ncs_v2_nunito_semibold"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_addends_choose_correct"
                        android:textColor="@color/ncs_v2_ink"
                        android:textSize="@dimen/ncs_v2_text_17" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ncs_v2_nunito_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/ncs_v2_choose_level_first"
                android:textColor="@color/ncs_v2_muted"
                android:textSize="@dimen/ncs_v2_text_15" />

            <LinearLayout
                android:id="@+id/ncs_v2_ready_button"
                style="@style/NcsV2.View.Action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ncs_v2_button_height"
                android:layout_marginTop="@dimen/ncs_v2_space_12"
                android:background="@drawable/ncs_v2_primary_button"
                android:clickable="true"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.NcsV2.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_ready"
                    android:textColor="@color/ncs_v2_surface" />

                <TextView
                    style="@style/TextAppearance.NcsV2.ForwardArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_arrow_forward"
                    android:textColor="@color/ncs_v2_surface" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
</layout>
