<?xml
    version="1.0"
    encoding="utf-8"
?>
<layout>
    <data/>
    <ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ncs_v2_paper"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        android:overScrollMode="never"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
    >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ncs_v2_space_24"
            android:paddingTop="@dimen/ncs_v2_space_12"
            android:paddingEnd="@dimen/ncs_v2_space_24"
            android:paddingBottom="@dimen/ncs_v2_space_12"
            android:clipChildren="false"
            android:clipToPadding="false"
        >
            <include
                layout="@layout/ncs_v2_brand_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            />
            <Space
                android:layout_width="1dp"
                android:layout_height="@dimen/ncs_v2_space_8"
            />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
            >
                <TextView
                    style="@style/TextAppearance.NcsV2.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_welcome_numbers_title"
                    android:lineSpacingMultiplier="1.08"
                />
                <TextView
                    style="@style/TextAppearance.NcsV2.Intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_find_missing_number"
                    android:textColor="@color/ncs_v2_primary"
                />
            </LinearLayout>
            <Space
                android:layout_width="1dp"
                android:layout_height="@dimen/ncs_v2_space_8"
            />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ncs_v2_nunito_bold"
                android:includeFontPadding="false"
                android:text="@string/ncs_v2_together"
                android:textColor="@color/ncs_v2_ink"
                android:textSize="16sp"
                android:layout_gravity="top|end"
                android:gravity="end"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
            />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_weight="1"
            >
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/raccoon_welcome"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center|bottom"
                />
                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="104dp"
                    android:src="@drawable/decor_plus_minus"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_gravity="end|center_vertical"
                />
            </FrameLayout>
            <Space
                android:layout_width="1dp"
                android:layout_height="@dimen/ncs_v2_space_8"
            />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ncs_v2_accent_outline"
                android:orientation="vertical"
                android:padding="20dp"
                android:clipChildren="false"
                android:clipToPadding="false"
            >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ncs_v2_nunito_extrabold"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_how_it_works"
                    android:textColor="@color/ncs_v2_primary"
                    android:textSize="@dimen/ncs_v2_text_14"
                />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="@dimen/ncs_v2_space_12"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                >
                    <TextView
                        android:layout_width="27dp"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/ncs_v2_nunito_black"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="7"
                        android:textColor="@color/ncs_v2_ink"
                        android:textSize="@dimen/ncs_v2_text_44"
                    />
                    <TextView
                        android:layout_width="19dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="11dp"
                        android:fontFamily="@font/ncs_v2_inter_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_math_equals"
                        android:textColor="@color/ncs_v2_yellow"
                        android:textSize="@dimen/ncs_v2_text_28"
                    />
                    <TextView
                        android:layout_width="27dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="11dp"
                        android:fontFamily="@font/ncs_v2_nunito_black"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="3"
                        android:textColor="@color/ncs_v2_ink"
                        android:textSize="@dimen/ncs_v2_text_44"
                    />
                    <TextView
                        android:layout_width="19dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="11dp"
                        android:fontFamily="@font/ncs_v2_inter_regular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_math_plus"
                        android:textColor="@color/ncs_v2_yellow"
                        android:textSize="@dimen/ncs_v2_text_28"
                    />
                    <TextView
                        android:layout_width="62dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="11dp"
                        android:background="@drawable/ncs_v2_addition_number"
                        android:fontFamily="@font/ncs_v2_nunito_black"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="4"
                        android:textColor="@color/ncs_v2_yellow"
                        android:textSize="@dimen/ncs_v2_text_44"
                    />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ncs_v2_space_12"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ncs_v2_nunito_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_addends_first_line"
                        android:textColor="@color/ncs_v2_ink"
                        android:textSize="@dimen/ncs_v2_text_17"
                        android:lineSpacingMultiplier="1.08"
                        android:minHeight="22dp"
                    />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:baselineAligned="true"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                    >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ncs_v2_nunito_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/ncs_v2_addends_instead"
                            android:textColor="@color/ncs_v2_ink"
                            android:textSize="@dimen/ncs_v2_text_17"
                            android:minHeight="22dp"
                        />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/ncs_v2_nunito_black"
                            android:includeFontPadding="false"
                            android:text="@string/ncs_v2_math_question_mark"
                            android:textColor="@color/ncs_v2_yellow"
                            android:textSize="@dimen/ncs_v2_text_17"
                            android:minHeight="22dp"
                        />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/ncs_v2_nunito_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/ncs_v2_addends_choose_correct"
                            android:textColor="@color/ncs_v2_ink"
                            android:textSize="@dimen/ncs_v2_text_17"
                            android:minHeight="22dp"
                        />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <Space
                android:layout_width="1dp"
                android:layout_height="@dimen/ncs_v2_space_8"
            />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
            >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ncs_v2_nunito_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_choose_level_first"
                    android:textColor="@color/ncs_v2_primary"
                    android:textSize="@dimen/ncs_v2_text_15"
                />
                <LinearLayout
                    android:id="@+id/ncs_v2_ready_button"
                    style="@style/NcsV2.View.Action"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ncs_v2_button_height"
                    android:layout_marginTop="@dimen/ncs_v2_space_12"
                    android:background="@drawable/ncs_v2_primary_button"
                    android:clickable="true"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                >
                    <TextView
                        style="@style/TextAppearance.NcsV2.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_ready"
                        android:textColor="@color/ncs_v2_surface"
                    />
                    <TextView
                        style="@style/TextAppearance.NcsV2.ForwardArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_arrow_forward"
                        android:textColor="@color/ncs_v2_surface"
                    />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>
