<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import type="android.view.View"/>
        <variable name="contextLabel" type="String"/>
    </data>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/ncs_v2_back_height" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <LinearLayout android:id="@+id/fractions_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="@dimen/ncs_v2_back_height" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:clickable="true" android:focusable="true" android:contentDescription="@string/fractions_back">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ncs_v2_fractions_back_arrow" android:scaleType="fitCenter" android:contentDescription="@null" android:importantForAccessibility="no"/>
            <TextView style="@style/TextAppearance.NcsV2.Fractions.ExtraBold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:includeFontPadding="false" android:layout_marginStart="8dp" android:textSize="17sp" android:textColor="@color/ncs_v2_primary" android:importantForAccessibility="no" android:text="@string/fractions_back"/>
        </LinearLayout>
        <TextView style="@style/TextAppearance.NcsV2.Fractions.ExtraBold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end|center_vertical" android:layout_marginStart="@dimen/ncs_v2_space_8" android:textSize="14sp" android:textColor="@color/ncs_v2_primary" tools:text="?attr/fractions_preview_context" android:text="@{contextLabel}"/>
    </LinearLayout>
</layout>
