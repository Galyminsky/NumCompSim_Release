<?xml
    version="1.0"
    encoding="utf-8"
?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
>
    <data>
        <import
            type="android.view.View"
        />
    </data>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ncs_v2_paper"
        android:fitsSystemWindows="true"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
    >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="@dimen/ncs_v2_space_12"
            android:paddingBottom="@dimen/ncs_v2_space_12"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
        >
            <include
                layout="@layout/ncs_v2_brand_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            />
            <Space
                android:layout_width="1dp"
                android:layout_height="@dimen/ncs_v2_space_8"
            />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
            >
                <TextView
                    style="@style/TextAppearance.NcsV2.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_comparison_rules_title"
                />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/ncs_v2_nunito_semibold"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/ncs_v2_comparison_rules_instruction"
                    android:textColor="@color/ncs_v2_primary"
                    android:textSize="@dimen/ncs_v2_text_17"
                />
            </LinearLayout>
            <Space
                android:layout_width="1dp"
                android:layout_height="@dimen/ncs_v2_space_8"
            />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_weight="1"
            >
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/raccoon_thinking"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                />
                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="104dp"
                    android:src="@drawable/decor_comparison"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:layout_gravity="end|center_vertical"
                />
            </FrameLayout>
            <Space
                android:layout_width="1dp"
                android:layout_height="@dimen/ncs_v2_space_8"
            />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ncs_v2_accent_outline"
                android:orientation="vertical"
                android:padding="20dp"
                android:clipChildren="false"
                android:clipToPadding="false"
            >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ncs_v2_nunito_extrabold"
                    android:includeFontPadding="false"
                    android:gravity="start"
                    android:text="@string/ncs_v2_comparison_rules_example_label"
                    android:textColor="@color/ncs_v2_primary"
                    android:textSize="@dimen/ncs_v2_text_14"
                />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ncs_v2_space_12"
                    android:contentDescription="@string/ncs_v2_comparison_rules_example_accessibility"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ncs_v2_nunito_black"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_comparison_rules_example_left"
                        android:textColor="@color/ncs_v2_expression_ink"
                        android:textSize="@dimen/ncs_v2_text_34"
                    />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ncs_v2_space_12"
                        android:layout_marginEnd="@dimen/ncs_v2_space_12"
                        android:fontFamily="@font/ncs_v2_nunito_black"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_comparison_rules_example_sign"
                        android:textColor="@color/ncs_v2_yellow"
                        android:textSize="@dimen/ncs_v2_text_36"
                    />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ncs_v2_nunito_black"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_comparison_rules_example_right"
                        android:textColor="@color/ncs_v2_expression_ink"
                        android:textSize="@dimen/ncs_v2_text_34"
                    />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ncs_v2_space_12"
                    android:fontFamily="@font/ncs_v2_nunito_semibold"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/ncs_v2_comparison_rules_explanation"
                    android:textColor="@color/ncs_v2_ink"
                    android:textSize="@dimen/ncs_v2_text_17"
                />
            </LinearLayout>
            <Space
                android:layout_width="1dp"
                android:layout_height="@dimen/ncs_v2_space_8"
            />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ncs_v2_nunito_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/ncs_v2_comparison_rules_hint"
                android:textColor="@color/ncs_v2_primary"
                android:textSize="@dimen/ncs_v2_text_15"
            />
            <LinearLayout
                android:id="@+id/ncs_v2_comparison_rules_ready_button"
                style="@style/NcsV2.View.Action"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ncs_v2_button_height"
                android:background="@drawable/ncs_v2_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
            >
                <TextView
                    style="@style/TextAppearance.NcsV2.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_comparison_rules_ready"
                    android:textColor="@color/ncs_v2_surface"
                />
                <TextView
                    style="@style/TextAppearance.NcsV2.ForwardArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:includeFontPadding="false"
                    android:text="@string/ncs_v2_arrow_forward"
                    android:textColor="@color/ncs_v2_surface"
                />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</layout>
