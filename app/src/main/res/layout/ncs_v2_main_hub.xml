<?xml
    version="1.0"
    encoding="utf-8"
?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
>
    <data/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ncs_v2_paper"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        android:overScrollMode="never"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
    >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/ncs_v2_space_24"
            android:paddingTop="@dimen/ncs_v2_space_12"
            android:paddingEnd="@dimen/ncs_v2_space_24"
            android:paddingBottom="@dimen/ncs_v2_space_12"
        >
            <include
                layout="@layout/ncs_v2_brand_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ncs_v2_space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
            >
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                >
                    <TextView
                        android:id="@+id/ncs_v2_main_hub_heading"
                        style="@style/TextAppearance.NcsV2.ScreenTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_choose_lesson_title"
                    />
                </LinearLayout>
                <ImageView
                    android:layout_width="106dp"
                    android:layout_height="94dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/raccoon_math"
                />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ncs_v2_space_8"
                android:fontFamily="@font/ncs_v2_nunito_semibold"
                android:includeFontPadding="false"
                android:text="@string/ncs_v2_hub_subtitle"
                android:textColor="@color/ncs_v2_muted"
                android:textSize="@dimen/ncs_v2_text_17"
            />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ncs_v2_space_8"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
            >
                <LinearLayout
                    android:id="@+id/ncs_v2_hub_arithmetic_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/ncs_v2_hub_arithmetic_card"
                    android:clickable="true"
                    android:contentDescription="@string/ncs_v2_hub_arithmetic_description"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="@dimen/ncs_v2_space_16"
                    android:paddingTop="3dp"
                    android:minHeight="182dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                >
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/decor_plus_minus"
                    />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ncs_v2_nunito_extrabold"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_hub_arithmetic"
                        android:textColor="@color/ncs_v2_ink"
                        android:textSize="@dimen/ncs_v2_text_20"
                    />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ncs_v2_space_8"
                        android:fontFamily="@font/ncs_v2_nunito_bold"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_hub_arithmetic_detail"
                        android:textColor="@color/ncs_v2_primary"
                        android:textSize="@dimen/ncs_v2_text_15"
                    />
                </LinearLayout>
                <Space
                    android:layout_width="@dimen/ncs_v2_space_12"
                    android:layout_height="0dp"
                />
                <LinearLayout
                    android:id="@+id/ncs_v2_hub_comparison_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/ncs_v2_hub_comparison_card"
                    android:clickable="true"
                    android:contentDescription="@string/ncs_v2_hub_comparison_description"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="@dimen/ncs_v2_space_16"
                    android:paddingTop="3dp"
                    android:minHeight="182dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                >
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/decor_comparison"
                    />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ncs_v2_nunito_extrabold"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_hub_comparison"
                        android:textColor="@color/ncs_v2_ink"
                        android:textSize="@dimen/ncs_v2_text_20"
                    />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ncs_v2_space_8"
                        android:fontFamily="@font/ncs_v2_nunito_bold"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_hub_comparison_detail"
                        android:textColor="@color/ncs_v2_primary"
                        android:textSize="@dimen/ncs_v2_text_15"
                    />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false">
                <LinearLayout
                    android:id="@+id/ncs_v2_hub_fractions_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="182dp"
                    android:orientation="vertical"
                    android:padding="@dimen/ncs_v2_space_16"
                    android:paddingTop="3dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:background="@drawable/ncs_v2_hub_fractions_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/ncs_v2_hub_fractions_description"
                    android:elevation="6dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:src="@drawable/raccoon_fractions"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ncs_v2_nunito_extrabold"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_hub_fractions"
                        android:textColor="@color/ncs_v2_ink"
                        android:textSize="@dimen/ncs_v2_text_20" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ncs_v2_space_8"
                        android:fontFamily="@font/ncs_v2_nunito_bold"
                        android:includeFontPadding="false"
                        android:text="@string/ncs_v2_hub_fractions_detail"
                        android:textColor="@color/ncs_v2_primary"
                        android:textSize="@dimen/ncs_v2_text_15" />
                </LinearLayout>
                <Space android:layout_width="12dp" android:layout_height="0dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/TextAppearance.NcsV2.Fractions.ExtraBold"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/ncs_v2_hub_coming_soon"
                        android:textColor="@color/ncs_v2_ink"
                        android:textSize="17sp" />
                    <include
                        layout="@layout/ncs_v2_hub_future_card"
                        android:layout_width="match_parent"
                        android:layout_height="128dp"
                        android:layout_marginTop="1dp"
                        android:layout_weight="0" />
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:layout_width="125dp"
                android:layout_height="@dimen/ncs_v2_touch_target_min"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/ncs_v2_space_8"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/raccoon_welcome"
                android:layout_weight="1"
            />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ncs_v2_space_8"
                android:fontFamily="@font/ncs_v2_nunito_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/ncs_v2_hub_hint"
                android:textColor="@color/ncs_v2_primary"
                android:textSize="@dimen/ncs_v2_text_15"
            />
        </LinearLayout>
    </ScrollView>
</layout>
