<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/ncsV2WelcomeFragment">

    <fragment
        android:id="@+id/ncsV2WelcomeFragment"
        android:name="me.proton.jobforandroid.compositionofnumbers.presentation.NcsV2WelcomeFragment"
        android:label="Общее приветствие"
        tools:layout="@layout/ncs_v2_welcome">
        <action
            android:id="@+id/action_ncsV2WelcomeFragment_to_mainHubFragment"
            app:destination="@id/mainHubFragment"
            app:popUpTo="@id/ncsV2WelcomeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/mainHubFragment"
        android:name="me.proton.jobforandroid.compositionofnumbers.presentation.MainHubFragment"
        android:label="Главный хаб"
        tools:layout="@layout/ncs_v2_main_hub">
        <action
            android:id="@+id/action_mainHubFragment_to_ncsV2LessonSelectionFragment"
            app:destination="@id/ncsV2LessonSelectionFragment" />
        <action
            android:id="@+id/action_mainHubFragment_to_comparisonRulesFragment"
            app:destination="@id/comparisonRulesFragment" />
    </fragment>

    <fragment
        android:id="@+id/comparisonRulesFragment"
        android:name="me.proton.jobforandroid.compositionofnumbers.presentation.ComparisonRulesFragment"
        android:label="Правила сравнения"
        tools:layout="@layout/ncs_v2_comparison_rules">
        <action
            android:id="@+id/action_comparisonRulesFragment_to_comparisonLevelFragment"
            app:destination="@id/comparisonLevelFragment" />
    </fragment>

    <fragment
        android:id="@+id/comparisonLevelFragment"
        android:name="me.proton.jobforandroid.compositionofnumbers.presentation.ComparisonLevelFragment"
        android:label="Выбор сложности сравнения"
        tools:layout="@layout/ncs_v2_comparison_level">
        <action
            android:id="@+id/action_comparisonLevelFragment_to_comparisonGameFragment"
            app:destination="@id/comparisonGameFragment" />
    </fragment>

    <fragment
        android:id="@+id/comparisonGameFragment"
        android:name="me.proton.jobforandroid.compositionofnumbers.presentation.ComparisonGameFragment"
        android:label="@string/ncs_v2_hub_comparison"
        tools:layout="@layout/ncs_v2_comparison_game">
        <action
            android:id="@+id/action_comparisonGameFragment_to_comparisonResultFragment"
            app:destination="@id/comparisonResultFragment"
            app:popUpTo="@id/comparisonGameFragment"
            app:popUpToInclusive="true" />
        <argument
            android:name="level"
            app:argType="me.proton.jobforandroid.compositionofnumbers.domain.entity.ComparisonLevel" />
    </fragment>

    <fragment
        android:id="@+id/comparisonResultFragment"
        android:name="me.proton.jobforandroid.compositionofnumbers.presentation.ComparisonResultFragment"
        android:label="@string/ncs_v2_game_result"
        tools:layout="@layout/ncs_v2_comparison_result">
        <action
            android:id="@+id/action_comparisonResultFragment_to_comparisonGameFragment"
            app:destination="@id/comparisonGameFragment"
            app:popUpTo="@id/comparisonResultFragment"
            app:popUpToInclusive="true" />
        <argument android:name="level"
            app:argType="me.proton.jobforandroid.compositionofnumbers.domain.entity.ComparisonLevel" />
        <argument android:name="answeredCount" app:argType="integer" />
        <argument android:name="correctCount" app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/ncsV2LessonSelectionFragment"
        android:name="me.proton.jobforandroid.compositionofnumbers.presentation.NcsV2LessonSelectionFragment"
        android:label="Выбор занятия"
        tools:layout="@layout/ncs_v2_lesson_selection">
        <action
            android:id="@+id/action_ncsV2LessonSelectionFragment_to_welcomeFragment"
            app:destination="@id/welcomeFragment" />
        <action
            android:id="@+id/action_ncsV2LessonSelectionFragment_to_subtractionIntroFragment"
            app:destination="@id/subtractionIntroFragment" />
        <action
            android:id="@+id/action_ncsV2LessonSelectionFragment_to_multiplicationIntroFragment"
            app:destination="@id/multiplicationIntroFragment" />
        <action
            android:id="@+id/action_ncsV2LessonSelectionFragment_to_divisionIntroFragment"
            app:destination="@id/divisionIntroFragment" />
    </fragment>

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="me.proton.jobforandroid.compositionofnumbers.presentation.WelcomeFragment"
        android:label="WelcomeFragment" >
        <action
            android:id="@+id/action_welcomeFragment_to_chooseLevelFragment2"
            app:destination="@id/chooseLevelFragment2" />
    </fragment>
    <fragment
        android:id="@+id/subtractionIntroFragment"
        android:name="me.proton.jobforandroid.compositionofnumbers.presentation.SubtractionIntroFragment"
        android:label="@string/ncs_v2_subtraction_intro_label"
        tools:layout="@layout/ncs_v2_subtraction_intro">
        <action
            android:id="@+id/action_subtractionIntroFragment_to_chooseLevelFragment2"
            app:destination="@id/chooseLevelFragment2" />
    </fragment>
    <fragment
        android:id="@+id/multiplicationIntroFragment"
        android:name="me.proton.jobforandroid.compositionofnumbers.presentation.MultiplicationIntroFragment"
        android:label="@string/ncs_v2_multiplication_intro_label"
        tools:layout="@layout/ncs_v2_multiplication_intro">
        <action
            android:id="@+id/action_multiplicationIntroFragment_to_chooseLevelFragment2"
            app:destination="@id/chooseLevelFragment2" />
    </fragment>
    <fragment
        android:id="@+id/divisionIntroFragment"
        android:name="me.proton.jobforandroid.compositionofnumbers.presentation.DivisionIntroFragment"
        android:label="@string/ncs_v2_division_intro_label"
        tools:layout="@layout/ncs_v2_division_intro">
        <action
            android:id="@+id/action_divisionIntroFragment_to_chooseLevelFragment2"
            app:destination="@id/chooseLevelFragment2" />
    </fragment>
    <fragment
        android:id="@+id/chooseLevelFragment2"
        android:name="me.proton.jobforandroid.compositionofnumbers.presentation.ChooseLevelFragment"
        android:label="fragment_choose_level"
        tools:layout="@layout/ncs_v2_level_selection" >
        <action
            android:id="@+id/action_chooseLevelFragment2_to_gameFragment"
            app:destination="@id/gameFragment" />
        <argument
            android:name="operation"
            app:argType="string"
            android:defaultValue="ADDITION" />
    </fragment>
    <fragment
        android:id="@+id/gameFragment"
        android:name="me.proton.jobforandroid.compositionofnumbers.presentation.GameFragment"
        android:label="fragment_game"
        tools:layout="@layout/ncs_v2_game" >
        <action
            android:id="@+id/action_gameFragment_to_gameFinishedFragment"
            app:destination="@id/gameFinishedFragment"
            app:popUpTo="@id/gameFragment"
            app:popUpToInclusive="true" />
        <argument
            android:name="level"
            app:argType="me.proton.jobforandroid.compositionofnumbers.domain.entity.Level" />
        <argument
            android:name="operation"
            app:argType="string"
            android:defaultValue="ADDITION" />
    </fragment>
    <fragment
        android:id="@+id/gameFinishedFragment"
        android:name="me.proton.jobforandroid.compositionofnumbers.presentation.GameFinishedFragment"
        android:label="fragment_game_finished"
        tools:layout="@layout/ncs_v2_result_success" >
        <argument
            android:name="gameResult"
            app:argType="me.proton.jobforandroid.compositionofnumbers.domain.entity.GameResult" />
        <argument
            android:name="level"
            app:argType="me.proton.jobforandroid.compositionofnumbers.domain.entity.Level" />
    </fragment>
</navigation>
